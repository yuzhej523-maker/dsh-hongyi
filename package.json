{
  "name": "dsh-hongyi",
  "version": "0.1.0",
  "description": "鸿驿（Hongyi）— 用一个邮箱把 DSH 的状态、任务进度、指令与文件送到手机上，不需要公网 IP、不需要自建服务器。",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "hongyi",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "hongyi",
    "remote",
    "imap",
    "smtp",
    "relay",
    "telemetry",
    "mailbox"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/smoke-host.mjs && node scripts/render-check.mjs",
    "test:all": "node scripts/smoke-phase1.mjs && node scripts/smoke-phase2.mjs && node scripts/smoke-phase3.mjs && node scripts/smoke-host.mjs && node scripts/render-check.mjs",
    "test:imap": "node scripts/imap-quiet-probe.mjs",
    "pack": "npm pack"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "mock/",
    "scripts/",
    "locale/",
    "icon.svg",
    "manifest.json",
    "cordis.patch.yml",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongyi-relay/dsh-hongyi.git"
  },
  "bugs": {
    "url": "https://github.com/hongyi-relay/dsh-hongyi/issues"
  },
  "homepage": "https://github.com/hongyi-relay/dsh-hongyi#readme"
}
